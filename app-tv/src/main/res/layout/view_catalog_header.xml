<?xml version="1.0" encoding="utf-8"?>
<!--
«Каталог» поверх сетки: чипы фильтров и счётчик, название и мета выбранной карточки,
пустой результат / ошибка. Размеры — макет f-cat (1 dp = 2 px кадра 1920×1080).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/catalog_chip_height"
        android:layout_marginStart="@dimen/main_top_tabs_margin_start"
        android:layout_marginTop="@dimen/catalog_chips_top"
        android:layout_marginEnd="@dimen/main_top_logo_margin_end"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/catalogChips"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ru.radiationx.anilibria.ui.widget.CatalogChipView
                android:id="@+id/catalogChipGenre"
                style="@style/AppTheme.CatalogChip" />

            <ru.radiationx.anilibria.ui.widget.CatalogChipView
                android:id="@+id/catalogChipYear"
                style="@style/AppTheme.CatalogChip" />

            <ru.radiationx.anilibria.ui.widget.CatalogChipView
                android:id="@+id/catalogChipSeason"
                style="@style/AppTheme.CatalogChip" />

            <ru.radiationx.anilibria.ui.widget.CatalogChipView
                android:id="@+id/catalogChipStatus"
                style="@style/AppTheme.CatalogChip" />

            <ru.radiationx.anilibria.ui.widget.CatalogChipView
                android:id="@+id/catalogChipSort"
                style="@style/AppTheme.CatalogChip"
                android:layout_marginEnd="0dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/catalogCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:visibility="invisible"
            tools:text="1 939 тайтлов"
            tools:visibility="visible" />

    </LinearLayout>

    <TextView
        android:id="@+id/catalogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/main_top_tabs_margin_start"
        android:layout_marginTop="@dimen/catalog_title_top"
        android:layout_marginEnd="@dimen/main_top_logo_margin_end"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        tools:text="Поднятие уровня в одиночку 2: Восстаньте из тени" />

    <TextView
        android:id="@+id/catalogMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/main_top_tabs_margin_start"
        android:layout_marginTop="@dimen/catalog_meta_top"
        android:layout_marginEnd="@dimen/main_top_logo_margin_end"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#B8FFFFFF"
        android:textSize="13sp"
        tools:text="2025 · Зима · ТВ · 13 эп. по 24 мин · 16+ · ★ 8,39 Shikimori · Экшен, Приключения, Фэнтези" />

    <LinearLayout
        android:id="@+id/catalogEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/catalog_empty_top"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/catalogEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            tools:text="По этим фильтрам ничего нет" />

        <TextView
            android:id="@+id/catalogEmptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#9EFFFFFF"
            android:textSize="14sp"
            tools:text="Уберите один из жанров или год" />

        <TextView
            android:id="@+id/catalogEmptyButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/catalog_empty_button_height"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_catalog_button"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="@color/catalog_button_text"
            android:textSize="15sp"
            tools:text="Сбросить фильтры" />

    </LinearLayout>

</FrameLayout>
