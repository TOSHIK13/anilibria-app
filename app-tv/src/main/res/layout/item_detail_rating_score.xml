<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка оценки в «★ Оценки»: источник, число, голоса, сайт. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_detail_rating_card"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/ratingScoreSource"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        tools:text="Shikimori" />

    <TextView
        android:id="@+id/ratingScoreValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp"
        tools:text="7,46" />

    <TextView
        android:id="@+id/ratingScoreVotes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        tools:text="16 538 голосов" />

    <TextView
        android:id="@+id/ratingScoreCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#73FFFFFF"
        android:textSize="11sp"
        tools:text="shikimori.io" />
</LinearLayout>
