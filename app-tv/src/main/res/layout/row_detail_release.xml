<?xml version="1.0" encoding="utf-8"?>
<!-- Шапка деталей релиза. Координаты — от левого верхнего угла экрана (макет 960x540dp). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowReleaseRoot"
    android:layout_width="match_parent"
    android:layout_height="480dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:background="#15212A">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/rowReleaseImageCard"
        android:layout_width="160dp"
        android:layout_height="228dp"
        android:layout_marginStart="744dp"
        android:layout_marginTop="48dp"
        android:background="#15212A"
        android:elevation="12dp"
        android:scaleType="centerCrop"
        android:theme="@style/AppTheme.Material"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/AppTheme.DetailPosterShape"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/rowReleaseNextEpisode"
        android:layout_width="210dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="694dp"
        android:layout_marginTop="294dp"
        android:background="@drawable/bg_detail_next_episode"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="11dp"
        android:paddingEnd="13dp"
        android:paddingBottom="11dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.1"
            android:text="СЛЕДУЮЩАЯ СЕРИЯ"
            android:textColor="#FFFF8A80"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rowReleaseNextEpisodeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            tools:text="Серия 8 · в пятницу" />

        <TextView
            android:id="@+id/rowReleaseNextEpisodeSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            tools:text="вышло 7 из 12 · по пятницам" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowReleaseTitleRu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="50dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxWidth="820dp"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="36sp"
        tools:text="Фантазия Гранблю 2" />

    <TextView
        android:id="@+id/rowReleaseTitleEn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="98dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxWidth="820dp"
        android:maxLines="1"
        android:textColor="#BFFFFFFF"
        android:textSize="15sp"
        tools:text="Granblue Fantasy The Animation Season 2" />

    <ru.radiationx.anilibria.ui.widget.SingleLineChipsLayout
        android:id="@+id/rowReleaseChips"
        android:layout_width="670dp"
        android:layout_height="24dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="126dp" />

    <TextView
        android:id="@+id/rowReleaseInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="161dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxWidth="670dp"
        android:maxLines="1"
        android:textColor="#B8FFFFFF"
        android:textSize="14sp"
        tools:text="Приключения · Фэнтези · 1 234 в избранном" />

    <!--
        Описание: фокусируемый блок (UP с кнопок), OK открывает полный текст.
        Отступы блока компенсируют padding, чтобы текст стоял на линии 56dp / 194dp.
    -->
    <LinearLayout
        android:id="@+id/rowReleaseDescriptionBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginTop="184dp"
        android:background="@drawable/bg_detail_description_block"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/rowReleaseDescription"
            android:layout_width="620dp"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="5"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            tools:text="@tools:sample/lorem/random" />

        <TextView
            android:id="@+id/rowReleaseDescriptionMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:duplicateParentState="true"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="Подробнее ›"
            android:textColor="@color/detail_description_more_text"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowReleaseActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="416dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rowReleaseActionContinue"
            style="@style/AppTheme.DetailPill"
            android:visibility="gone"
            tools:text="▶ Продолжить · серия 5"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/rowReleaseActionPlay"
            style="@style/AppTheme.DetailPill"
            android:text="Смотреть" />

        <TextView
            android:id="@+id/rowReleaseActionFavorite"
            style="@style/AppTheme.DetailPill"
            android:text="☆ В избранное" />

        <TextView
            android:id="@+id/rowReleaseActionCollection"
            style="@style/AppTheme.DetailPill"
            android:text="В коллекцию ▾" />

        <TextView
            android:id="@+id/rowReleaseActionRatings"
            style="@style/AppTheme.DetailPill"
            android:text="★ Оценки"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/rowReleaseActionOther"
            style="@style/AppTheme.DetailPill"
            android:paddingStart="19dp"
            android:paddingEnd="19dp"
            android:text="⋮" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/rowReleaseUpdateProgress"
        style="?android:progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:visibility="invisible" />

    <ProgressBar
        android:id="@+id/rowReleaseLoadingProgress"
        style="?android:progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="invisible" />

</FrameLayout>
