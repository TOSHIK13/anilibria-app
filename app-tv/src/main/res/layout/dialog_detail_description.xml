<?xml version="1.0" encoding="utf-8"?>
<!-- Полное описание релиза: затемнение на весь экран, колонка текста по центру. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F70A0E12">

    <LinearLayout
        android:layout_width="760dp"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="56dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/detailDescriptionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            tools:text="Фантазия Гранблю 2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:includeFontPadding="false"
            android:letterSpacing="0.1"
            android:text="ОПИСАНИЕ"
            android:textColor="#FFFF8A80"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/detailDescriptionScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:fadingEdgeLength="32dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:requiresFadingEdge="vertical"
            android:scrollbarSize="3dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbarThumbVertical="@drawable/scrollbar_detail_description"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/detailDescriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:textColor="#EBFFFFFF"
                android:textSize="16sp"
                tools:text="@tools:sample/lorem/random" />
        </ScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:includeFontPadding="false"
            android:text="▲▼ прокрутка · Назад — закрыть"
            android:textColor="#80FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
