<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/browse_dummy"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.leanback.widget.BrowseFrameLayout
        android:id="@+id/grid_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:descendantFocusability="afterDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="48dp"
            android:paddingTop="32dp"
            android:paddingEnd="48dp"
            android:paddingBottom="32dp">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:theme="@style/AppTheme.Material">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Настройки"
                    android:textColor="@color/dark_textDefault"
                    android:textSize="28sp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/settingsAvatar"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/dark_cardBackground"
                    android:elevation="16dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:src="@drawable/alib_splash_fg" />

                <TextView
                    android:id="@+id/settingsNick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/dark_textDefault"
                    android:textSize="22sp"
                    android:visibility="gone"
                    tools:text="Гость" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsAuthAction"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:text="Авторизоваться" />

                <TextView
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"
                    android:text="Плеер"
                    android:textColor="@color/dark_textDefault"
                    android:textSize="18sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsSkips"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:nextFocusUp="@id/settingsAuthAction"
                    android:text="Кнопки пропуска: Вкл" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsAutoSkip"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:nextFocusUp="@id/settingsSkips"
                    android:text="Автопропуск: Вкл" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsAutoplay"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:nextFocusUp="@id/settingsAutoSkip"
                    android:text="Автовоспроизведение: Вкл" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsBackBuffer"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:nextFocusUp="@id/settingsAutoplay"
                    android:text="Буфер назад: 0 сек." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsForwardBuffer"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:nextFocusUp="@id/settingsBackBuffer"
                    android:text="Буфер вперёд: 50 сек." />

            </androidx.appcompat.widget.LinearLayoutCompat>
        </ScrollView>
    </androidx.leanback.widget.BrowseFrameLayout>
</FrameLayout>
