<?xml version="1.0" encoding="utf-8"?>
<!-- Настройки: слева разделы, справа строки выбранного раздела (прокручивается только правая часть). -->
<ru.radiationx.anilibria.screen.profile.SettingsFocusLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="afterDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingTop="80dp">

        <LinearLayout
            android:id="@+id/settingsNav"
            android:layout_width="210dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="56dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/settingsPaneTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp" />

            <ScrollView
                android:id="@+id/settingsScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:overScrollMode="never"
                android:paddingBottom="24dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settingsRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</ru.radiationx.anilibria.screen.profile.SettingsFocusLayout>
