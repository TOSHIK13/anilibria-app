<?xml version="1.0" encoding="utf-8"?>
<!-- Первая синхронизация с AniList: счётчики сравнения, выбор политики, кнопки. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_windowBackground">

    <LinearLayout
        android:id="@+id/fsContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="54dp"
        android:paddingTop="38dp"
        android:paddingEnd="54dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="@string/first_sync_title"
            android:textColor="#FFEEEEEE"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/first_sync_subtitle"
            android:textColor="#FFB2B2B2"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/fsTiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.08"
            android:text="@string/first_sync_policy_section"
            android:textColor="#FF909090"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/fsPolicies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/fsHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFF2C14E"
            android:textSize="12sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/fsButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fsStart"
                style="@style/FirstSyncButton"
                android:text="@string/first_sync_start" />

            <TextView
                android:id="@+id/fsDiff"
                style="@style/FirstSyncButton"
                android:layout_marginStart="12dp"
                android:text="@string/first_sync_diff" />

            <TextView
                android:id="@+id/fsLater"
                style="@style/FirstSyncButton"
                android:layout_marginStart="12dp"
                android:text="@string/first_sync_later" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fsStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fsStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxWidth="520dp"
            android:textColor="#FFB2B2B2"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/fsRetry"
            style="@style/FirstSyncButton"
            android:layout_marginTop="16dp"
            android:text="@string/first_sync_retry" />

        <TextView
            android:id="@+id/fsStatusLater"
            style="@style/FirstSyncButton"
            android:layout_marginTop="10dp"
            android:text="@string/first_sync_later" />
    </LinearLayout>
</FrameLayout>
