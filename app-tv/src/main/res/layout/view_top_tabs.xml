<?xml version="1.0" encoding="utf-8"?>
<ru.radiationx.anilibria.ui.widget.TopTabsView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/browse_title_group"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/top_tabs_container"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/main_top_tab_height"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/main_top_tabs_margin_start"
        android:layout_marginTop="@dimen/main_top_tabs_margin_top"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <ImageView
        android:id="@+id/top_tabs_logo"
        android:layout_width="@dimen/main_top_logo_size"
        android:layout_height="@dimen/main_top_logo_size"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/main_top_logo_margin_top"
        android:layout_marginEnd="@dimen/main_top_logo_margin_end"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/alib_splash_fg" />
</ru.radiationx.anilibria.ui.widget.TopTabsView>
