<?xml version="1.0" encoding="utf-8"?>
<!-- Строка расхождений: Тайтл | AniLiberty | AniList | Итог; у конфликта при фокусе — выбор статуса. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/frTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.2"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingEnd="8dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/frLocal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:includeFontPadding="false"
            android:paddingEnd="8dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/frRemote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:includeFontPadding="false"
            android:paddingEnd="8dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/frResult"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:includeFontPadding="false"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/frChoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/frChoiceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/first_sync_choice_label"
            android:textColor="#FF555555"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/frChoiceLocal"
            style="@style/FirstSyncChoiceButton"
            android:layout_marginStart="10dp" />

        <TextView
            android:id="@+id/frChoiceRemote"
            style="@style/FirstSyncChoiceButton"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
