<?xml version="1.0" encoding="utf-8"?>
<!-- Фон карточки части франшизы: белый 8%, в фокусе — белый 16% поверх почти непрозрачной
     подложки (карточка в фокусе увеличена и перекрывает соседей, они не должны просвечивать). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#F2181D24" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#29FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
</selector>
