<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/main_top_tab_focused_background" />
            <corners android:radius="@dimen/main_top_tab_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/main_top_tab_underline" />
            <corners android:radius="@dimen/main_top_tab_corner_radius" />
        </shape>
    </item>
</selector>
