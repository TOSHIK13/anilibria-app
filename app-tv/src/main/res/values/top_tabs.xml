<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Верхняя панель вкладок главного экрана (MainPagesFragment). -->
    <dimen name="main_top_tabs_margin_start">56dp</dimen>
    <dimen name="main_top_tabs_margin_top">18dp</dimen>
    <dimen name="main_top_tab_height">36dp</dimen>
    <dimen name="main_top_tab_gap">4dp</dimen>
    <dimen name="main_top_tab_padding_horizontal">14dp</dimen>
    <dimen name="main_top_tab_corner_radius">18dp</dimen>
    <dimen name="main_top_tab_text_size">16sp</dimen>
    <dimen name="main_top_tab_underline_height">2dp</dimen>
    <dimen name="main_top_tab_underline_radius">1dp</dimen>
    <dimen name="main_top_tab_underline_bottom">3dp</dimen>
    <dimen name="main_top_tab_alert_margin_start">12dp</dimen>
    <dimen name="main_top_logo_size">48dp</dimen>
    <dimen name="main_top_logo_margin_top">12dp</dimen>
    <dimen name="main_top_logo_margin_end">56dp</dimen>

    <!--
    Отступ первого ряда от верха экрана (под вкладками; позже сюда добавится hero-блок).
    Leanback выравнивает по верху карточек (row_content), заголовок ряда (~28dp) стоит над ним:
    92dp = верх заголовка первого ряда на 64dp.
    -->
    <dimen name="main_rows_top_offset">92dp</dimen>
    <!-- Верх контента нестроковых страниц (настройки) под вкладками. -->
    <dimen name="main_page_content_top">64dp</dimen>

    <color name="main_top_tab_underline">#E53935</color>
    <color name="main_top_tab_focused_background">#FFFFFF</color>
    <color name="main_top_tab_focused_text">#111111</color>
    <color name="main_top_tab_selected_text">#FFFFFF</color>
    <color name="main_top_tab_text_default">#9EFFFFFF</color>

    <!-- Применяется только на время BrowseSupportFragment.onCreate в MainPagesFragment. -->
    <style name="ThemeOverlay.MainPages" parent="">
        <item name="browseRowsMarginTop">@dimen/main_rows_top_offset</item>
    </style>
</resources>
