<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Верхняя панель вкладок главного экрана (MainPagesFragment). -->
    <dimen name="main_top_tabs_margin_start">56dp</dimen>
    <dimen name="main_top_tabs_margin_top">18dp</dimen>
    <dimen name="main_top_tab_height">36dp</dimen>
    <dimen name="main_top_tab_gap">4dp</dimen>
    <dimen name="main_top_tab_padding_horizontal">14dp</dimen>
    <dimen name="main_top_tab_corner_radius">18dp</dimen>
    <dimen name="main_top_tab_text_size">16sp</dimen>
    <dimen name="main_top_tab_underline_height">2dp</dimen>
    <dimen name="main_top_tab_underline_radius">1dp</dimen>
    <dimen name="main_top_tab_underline_bottom">3dp</dimen>
    <dimen name="main_top_tab_alert_margin_start">12dp</dimen>
    <dimen name="main_top_logo_size">48dp</dimen>
    <dimen name="main_top_logo_margin_top">12dp</dimen>
    <dimen name="main_top_logo_margin_end">56dp</dimen>

    <!--
    Высота выбранного ряда (под hero-блоком, см. MainHeroView). Leanback держит выбранный ряд
    всегда на этой высоте (WINDOW_ALIGN_NO_EDGE). Подобрано по скриншоту под макет:
    заголовок ряда на 224dp, верх карточек на 258dp.
    -->
    <dimen name="main_rows_top_offset">242dp</dimen>
    <!-- Верх контента нестроковых страниц (настройки) под вкладками. -->
    <dimen name="main_page_content_top">64dp</dimen>
    <!-- «Каталог»: чипы фильтров, строка выбранной карточки и сетка под ними (макет f-cat). -->
    <dimen name="catalog_chips_top">66dp</dimen>
    <dimen name="catalog_chip_height">32dp</dimen>
    <dimen name="catalog_chip_gap">8dp</dimen>
    <dimen name="catalog_chip_padding_horizontal">14dp</dimen>
    <dimen name="catalog_chip_corner_radius">16dp</dimen>
    <dimen name="catalog_chip_text_size">13sp</dimen>
    <dimen name="catalog_title_top">114dp</dimen>
    <dimen name="catalog_meta_top">143dp</dimen>
    <!-- Верх области сетки: ряды при прокрутке обрезаются под строкой меты. -->
    <dimen name="catalog_grid_top">161dp</dimen>
    <!-- Первый ряд постеров на 178dp; запас сверху под увеличение карточки в фокусе. -->
    <dimen name="catalog_grid_padding_top">17dp</dimen>
    <dimen name="catalog_grid_padding_bottom">24dp</dimen>
    <dimen name="catalog_grid_horizontal_spacing">8dp</dimen>
    <dimen name="catalog_grid_vertical_spacing">16dp</dimen>
    <dimen name="catalog_empty_top">214dp</dimen>
    <dimen name="catalog_empty_button_height">44dp</dimen>
    <!-- Высота карточек выбранного ряда «Расписания»: заголовок дня над ними не заходит под вкладки. -->
    <dimen name="schedule_rows_top_offset">104dp</dimen>

    <color name="main_top_tab_underline">#E53935</color>
    <color name="main_top_tab_focused_background">#FFFFFF</color>
    <color name="main_top_tab_focused_text">#111111</color>
    <color name="main_top_tab_selected_text">#FFFFFF</color>
    <color name="main_top_tab_text_default">#9EFFFFFF</color>

    <style name="AppTheme.CatalogChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginEnd">@dimen/catalog_chip_gap</item>
        <item name="android:paddingStart">@dimen/catalog_chip_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/catalog_chip_padding_horizontal</item>
        <item name="android:background">@drawable/bg_catalog_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">@dimen/catalog_chip_text_size</item>
    </style>

    <!-- Применяется только на время BrowseSupportFragment.onCreate в MainPagesFragment. -->
    <style name="ThemeOverlay.MainPages" parent="">
        <item name="browseRowsMarginTop">@dimen/main_rows_top_offset</item>
    </style>
</resources>
